# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://meerko:meerko@127.0.0.1:54329/meerko

# API server
PORT=8787
# Public URL of this deployment (no domain is hard-coded anywhere)
MEERKO_PUBLIC_URL=http://localhost:8787
# Web dashboard URL; after connecting Gmail or signing in, the browser is sent back there.
# Also required for Google sign-in, agent (OAuth) sign-in and billing.
MEERKO_APP_URL=http://localhost:3000

# Lead search + email enrichment (https://app.icypeas.com > API). Search routes return 503 without it.
ICYPEAS_API_KEY=

# Meter enrichment in Meerko credits (cloud). Leave off when self-hosting with your own provider keys.
# Configuring Stripe (below) turns it on.
MEERKO_CREDITS=off

# Encrypts mailbox app passwords and tokens, workspace provider keys (BYOK) and unsubscribe links. Needed to
# send, for Google sign-in and agent sign-in. Generate with: openssl rand -base64 32. Never change it once
# mailboxes are connected. Mailboxes connect with a Gmail app password, so sending needs nothing else.
MEERKO_ENCRYPTION_KEY=

# Optional: "Sign in with Google" for the dashboard (Google Cloud console > APIs & Services > Credentials >
# OAuth client, type "Web application"). Authorized redirect URIs:
#   ${MEERKO_PUBLIC_URL}/auth/google/callback    (dashboard sign-in; also needs MEERKO_APP_URL)
#   ${MEERKO_PUBLIC_URL}/oauth/google/callback   (only with MEERKO_GMAIL_OAUTH=1)
# Without them the dashboard logs in with an API key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 also offers Google's consent page (Gmail API, enable it in the project) for connecting mailboxes.
MEERKO_GMAIL_OAUTH=

# Optional: Outlook / Microsoft 365 mailboxes. Register an app in Microsoft Entra (App registrations), for
# "any organizational directory and personal Microsoft accounts", with the redirect URI
# ${MEERKO_PUBLIC_URL}/oauth/microsoft/callback and the delegated Microsoft Graph permissions
# Mail.Send, Mail.Read, User.Read and offline_access. Then a client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Who can sign in with Google: "invite" (emails added with `pnpm db:invite`) or "open" (anyone gets a workspace)
MEERKO_SIGNUP=invite

# Web dashboard (/app): where the Next.js server reaches the API. Defaults to http://localhost:8787.
MEERKO_API_URL=http://localhost:8787

# Cloud only: lets Cloud Scheduler run background work via POST /internal/tick instead of a worker
# process. Generate with: openssl rand -hex 32. Self-hosters run apps/worker and leave this empty.
MEERKO_TICK_SECRET=

# Agent hooks (Settings → Wake your agent) call only public https URLs. Set to 1 on a self-hosted install to
# allow hooks on your own network, e.g. a local n8n.
MEERKO_ALLOW_PRIVATE_HOOKS=

# Billing (Meerko Cloud). Leave empty for no billing and no plan limits, the default for self-hosting.
# Meerko Cloud's values come from Terraform (terraform/app/stripe.tf). Locally: test-mode keys, and
# `stripe listen --forward-to localhost:8787/stripe/webhook` prints the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDITS=
# Optional: a customer portal configuration (bpc_…), and "on" for Stripe Tax at Checkout.
STRIPE_PORTAL_CONFIGURATION=
STRIPE_AUTOMATIC_TAX=

# PostHog analytics (EU cloud). Leave empty and nothing is sent anywhere, which is the default for
# self-hosting. Meerko Cloud's values come from Terraform (terraform/app/posthog.tf).
# API: product events, errors and MCP analytics for the hosted /mcp. The local stdio MCP server
# (meerko-mcp) also reads these, and sends nothing without POSTHOG_API_KEY.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
APP_ENV=local
# Web app: the same phc_ project key, inlined into the browser bundle at build time. Next.js reads env
# files from apps/web, so for local runs put these two in apps/web/.env.local.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_APP_ENV=local

# Docker image builds only (apps/web/Dockerfile, docker-compose.selfhost.yml): the dashboard's public URL, built in.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack app (optional): Approve buttons on drafts and /meerko. Create the app from the manifest shown at
# /docs/slack, then copy these from its Basic Information page. Without them, Settings → Slack takes a pasted
# incoming webhook instead (posts only).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
