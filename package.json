{
  "name": "meerko",
  "private": true,
  "description": "Meerko — the open-source GTM agent.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config merge.autoStash true && git config rebase.autoStash true || true",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @meerko/db generate",
    "db:migrate": "pnpm --filter @meerko/db migrate",
    "db:seed": "pnpm --filter @meerko/core seed",
    "db:invite": "pnpm --filter @meerko/core invite",
    "db:seed-reviewer": "pnpm --filter @meerko/core seed-reviewer",
    "db:reviewer-link": "pnpm --filter @meerko/core reviewer-link",
    "db:add-member": "pnpm --filter @meerko/core add-member",
    "meerko": "tsx packages/cli/src/index.ts",
    "docs:reference": "tsx scripts/docs-reference.mts",
    "api:spec": "tsx scripts/openapi.mts",
    "chatgpt-plugin": "node scripts/build-chatgpt-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
